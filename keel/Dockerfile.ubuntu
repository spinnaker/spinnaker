FROM ubuntu:jammy
LABEL maintainer="sig-platform@spinnaker.io"
RUN apt-get update && apt-get -y install openjdk-17-jre-headless wget
# Refresh the CA bundle, remove G1, and rebuild the JVM truststore from scratch.
RUN apt-get update && apt-get -y install --only-upgrade ca-certificates ca-certificates-java && \
    sed -i 's@^mozilla/emSign_Root_CA_-_G1.crt$@!mozilla/emSign_Root_CA_-_G1.crt@' /etc/ca-certificates.conf && \
    rm -f /etc/ssl/certs/java/cacerts && update-ca-certificates --fresh && \
    rm -rf /var/lib/apt/lists/* && \
    ! keytool -list -cacerts -storepass changeit | grep -qiE 'emsign.*root.*g[123]|comodo.*aaa|aaa.*certificate.*services'
RUN adduser --system --uid 10111 --group spinnaker
COPY keel-web/build/install/keel /opt/keel
RUN mkdir -p /opt/keel/plugins && chown -R spinnaker:nogroup /opt/keel/plugins
USER spinnaker
CMD ["/opt/keel/bin/keel"]
