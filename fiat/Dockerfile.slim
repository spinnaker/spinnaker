FROM alpine:3.24
LABEL maintainer="sig-platform@spinnaker.io"
RUN apk --no-cache add --update bash curl openjdk25-jre
# Pick up the latest CA bundle and fail the build if the JVM still trusts emSign ECC Root CA - G3.
RUN apk --no-cache upgrade && ! keytool -list -cacerts -storepass changeit | grep -qiE 'emsign.*ecc.*g3'
RUN addgroup -S -g 10111 spinnaker
RUN adduser -S -G spinnaker -u 10111 spinnaker
COPY fiat-web/build/install/fiat /opt/fiat
RUN mkdir -p /opt/fiat/plugins && chown -R spinnaker:nogroup /opt/fiat/plugins
USER spinnaker
HEALTHCHECK CMD curl http://localhost:7003/health | grep UP || exit 1
CMD ["/opt/fiat/bin/fiat"]
