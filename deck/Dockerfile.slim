FROM debian:stable-slim
LABEL maintainer="sig-platform@spinnaker.io"

WORKDIR /opt/deck
COPY docker        /opt/deck/docker
RUN docker/setup-apache2.sh

COPY packages/app/dist /opt/deck/html
RUN docker/compress-assets.sh /opt/deck/html \
    && chown -R www-data:www-data /opt/deck
USER www-data

# SIGWINCH is Apache's graceful stop: finish in-flight requests, then exit.
STOPSIGNAL SIGWINCH
CMD ["docker/run-apache2.sh"]
