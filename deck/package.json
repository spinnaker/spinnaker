{
  "main": "./dist/bundle.js",
  "name": "deck",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/spinnaker/spinnaker.git"
  },
  "publishConfig": {
    "registry": "http://artifacts.netflix.com/api/npm/npm-local"
  },
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "scripts": {
    "clean": "rimraf build packages/*/dist",
    "fixup": "scripts/monorepo_fixup.sh",
    "build": "pnpm --filter deck-app build",
    "lint": "eslint --max-warnings=0 --ext js,jsx,ts,tsx packages",
    "start": "sh ./start.sh",
    "start-dev-server": "pnpm --filter deck-app start-dev-server",
    "typecheck": "pnpm --filter deck-app typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "modules": "./scripts/buildModules.js",
    "prettier": "prettier --write 'packages/**/*.{js,jsx,ts,tsx,html,css,less}'",
    "prettier:check": "prettier --check 'packages/**/*.{js,jsx,ts,tsx,html,css,less}'",
    "functional": "pnpm --dir test/functional install && pnpm --dir test/functional build && pnpm --dir test/functional test",
    "functional:debug": "pnpm --dir test/functional install && pnpm --dir test/functional build && pnpm --dir test/functional open"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.2",
    "@spinnaker/eslint-plugin": "workspace:^",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "12.1.5",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "16.4.13",
    "@typescript-eslint/eslint-plugin": "8.32.0",
    "@typescript-eslint/parser": "8.32.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "^17.2.0",
    "jquery": "3.7.1",
    "jsdom": "30.0.1",
    "kleur": "^4.1.4",
    "lerna": "^10.0.0",
    "lodash": "4.18.1",
    "prettier": "2.1.2",
    "prompts": "^2.4.1",
    "rimraf": "6.1.3",
    "sisteransi": "^1.0.5",
    "vitest": "4.1.10",
    "yargs": "^17.0.1"
  },
  "optionalDependencies": {
    "fsevents": "2.3.2"
  },
  "lint-staged": {
    "packages/**/*.{js,jsx,ts,tsx}": "eslint --fix",
    "packages/**/*.{js,jsx,ts,tsx,html,css,less}": "prettier --write"
  }
}
