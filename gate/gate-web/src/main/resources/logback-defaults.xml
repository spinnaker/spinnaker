<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p ${PID:- } --- [%15.15t] %-40.40logger{39} : [%X{X-SPINNAKER-USER}] %m%n
      </pattern>
    </encoder>
  </appender>

  <appender name="json" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <includeMdc>true</includeMdc>
      <excludeMdcKeyName>X-SPINNAKER-ACCOUNTS</excludeMdcKeyName>
      <excludeMdcKeyName>X-SPINNAKER-IDENTITY-TOKEN</excludeMdcKeyName>
      <includeContext>false</includeContext>
    </encoder>
  </appender>

  <logger name="org.opensaml" level="DEBUG"/>

  <root level="INFO">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
