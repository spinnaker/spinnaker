FROM ubuntu:resolute
LABEL maintainer="sig-platform@spinnaker.io"
RUN rm /var/lib/dpkg/info/libc-bin.* && apt-get clean && apt-get update && apt-get -y install curl openjdk-25-jre-headless wget
# Pick up the latest CA bundle and fail the build if the JVM still trusts emSign ECC Root CA - G3.
RUN apt-get update && apt-get -y install --only-upgrade ca-certificates ca-certificates-java && rm -rf /var/lib/apt/lists/* && ! keytool -list -cacerts -storepass changeit | grep -qiE 'emsign.*ecc.*g3'
RUN adduser --system --uid 10111 --group spinnaker
COPY echo-web/build/install/echo /opt/echo
RUN mkdir -p /opt/echo/plugins && chown -R spinnaker:nogroup /opt/echo/plugins
USER spinnaker
HEALTHCHECK CMD curl http://localhost:8089/health | grep UP || exit 1
CMD ["/opt/echo/bin/echo"]
